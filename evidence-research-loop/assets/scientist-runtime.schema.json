{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/evidence-research-loop/scientist-runtime.schema.json",
  "title": "Executable Evidence Research Loop Scientist Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_version",
    "research_question",
    "claim_boundary",
    "budget",
    "stages"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "plan_version": {"type": "string", "minLength": 1},
    "research_question": {"type": "string", "minLength": 1},
    "claim_boundary": {"type": "string", "minLength": 1},
    "frozen_input_files": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_stage_calls", "max_wall_time_sec"],
      "properties": {
        "max_stage_calls": {"type": "integer", "minimum": 1},
        "max_wall_time_sec": {"type": "number", "exclusiveMinimum": 0},
        "max_known_cost_usd": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_claim_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ideation", "literature", "experiment", "analysis", "review"],
      "properties": {
        "ideation": {"$ref": "#/$defs/stage"},
        "literature": {"$ref": "#/$defs/stage"},
        "experiment": {"$ref": "#/$defs/stage"},
        "analysis": {"$ref": "#/$defs/stage"},
        "review": {"$ref": "#/$defs/stage"}
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "instructions": {"type": "string"},
        "max_attempts": {"type": "integer", "minimum": 1},
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "command"],
          "properties": {
            "kind": {"const": "command"},
            "command": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "timeout_sec": {"type": "number", "exclusiveMinimum": 0},
            "may_use_model": {"type": "boolean"},
            "env_allowlist": {
              "type": "array",
              "items": {"type": "string"},
              "uniqueItems": true
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}},
          "then": {"required": ["backend"]}
        }
      ]
    }
  }
}
