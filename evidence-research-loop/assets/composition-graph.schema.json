{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ERL engineering composition graph",
  "description": "Blueprint structure. The runtime additionally checks claim identities, frozen verifier integrity and root acceptance requirements.",
  "type": "object",
  "required": ["schema_version", "graph_id", "title", "goal_claim_ids", "claims"],
  "properties": {
    "schema_version": {"const": 1},
    "graph_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "goal_claim_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claims": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/claim"}
    }
  },
  "$defs": {
    "verifier": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "frozen_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "env_allowlist": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "timeout_sec": {"type": "number", "exclusiveMinimum": 0, "maximum": 120},
        "result_file": {"type": "string", "minLength": 1},
        "pass_field": {"type": "string", "minLength": 1}
      }
    },
    "claim": {
      "type": "object",
      "required": ["id", "statement", "contract", "environment", "scope", "guarantee", "verifiers"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "contract": {"type": "object"},
        "environment": {"type": "object"},
        "scope": {"type": "string", "minLength": 1},
        "guarantee": {"const": "empirical"},
        "requires_human_review": {"type": "boolean"},
        "verifiers": {
          "type": "object",
          "properties": {
            "direct": {"$ref": "#/$defs/verifier"},
            "composition": {"$ref": "#/$defs/verifier"},
            "integration": {"$ref": "#/$defs/verifier"},
            "holdout": {"$ref": "#/$defs/verifier"},
            "refutation": {"$ref": "#/$defs/verifier"}
          },
          "additionalProperties": false
        }
      }
    },
    "submission": {
      "oneOf": [
        {
          "type": "object", "required": ["kind", "claim_id", "artifact"],
          "properties": {
            "kind": {"enum": ["direct", "refutation"]},
            "claim_id": {"type": "string", "minLength": 1},
            "artifact": {"type": "string", "minLength": 1},
            "author": {"type": "object"}
          }
        },
        {
          "type": "object", "required": ["kind", "claim_id", "premises", "artifact"],
          "properties": {
            "kind": {"const": "reduction"},
            "claim_id": {"type": "string", "minLength": 1},
            "premises": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "artifact": {"type": "string", "minLength": 1},
            "author": {"type": "object"}
          }
        },
        {
          "type": "object", "required": ["kind", "reduction_id", "bindings"],
          "properties": {
            "kind": {"const": "validate"},
            "reduction_id": {"type": "string", "minLength": 1},
            "bindings": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
            "author": {"type": "object"}
          }
        }
      ]
    }
  }
}
