{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Research Loop research graph blueprint",
  "type": "object",
  "required": ["schema_version", "graph_id", "title", "goal_node_ids", "nodes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "graph_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "goal_node_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "statement", "dependencies", "output_contract"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "pattern": "^[^\\s]+$"},
          "type": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "scope": {"type": "string", "minLength": 1},
          "priority": {"type": "integer"},
          "max_attempts": {"type": "integer", "minimum": 1},
          "output_contract": {"type": "object"},
          "verifier": {
            "type": "object",
            "required": ["id", "command"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string"}
              },
              "frozen_files": {
                "description": "Additional local verifier dependencies to hash at graph initialization.",
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "frozen_file_manifest": {
                "description": "Runtime-generated immutable hash manifest.",
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "sha256", "size_bytes", "source"],
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "size_bytes": {"type": "integer", "minimum": 0},
                    "source": {"enum": ["command", "explicit"]}
                  }
                }
              },
              "contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "env_allowlist": {
                "description": "Extra environment variable names explicitly exposed to the verifier.",
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "timeout_sec": {"type": "number", "exclusiveMinimum": 0},
              "result_file": {"type": "string", "minLength": 1},
              "pass_field": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
